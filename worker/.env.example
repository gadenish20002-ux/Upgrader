# --- Донор ---
DONOR_BASE_URL=https://upgrader.pro
DONOR_HEADLESS=true          # false иногда стабильнее проходит Cloudflare
# DONOR_PROFILE_DIR=./.browser-profile

# --- Скины ---
PAGE_DELAY_MS=1500           # пауза между страницами API (1000–2000)
DOWNLOAD_IMAGES=true         # false → не качать, оставлять ссылки Steam CDN (для Vercel)
# SKINS_OUT=../lib/skins-data.json
# IMAGES_DIR=../public/images/skins

# --- Расписание (node-cron) ---
SKINS_CRON=*/30 * * * *      # скины раз в 30 минут
STATS_CRON=* * * * *         # статистика раз в минуту

# --- Пуш статистики на прод (опционально, если фронт на Vercel) ---
# STATS_PUSH_URL=https://ВАШ-САЙТ/api/v1/stats
# STATS_PUSH_SECRET=придумай-секрет   # должен совпасть с STATS_PUSH_SECRET на сайте
